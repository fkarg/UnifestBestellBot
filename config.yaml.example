# UnifestBestellBot configuration for one event.
#
# Edit between events, then restart the bot. The schema is validated at
# startup: a typo here will refuse to boot.
#
# Mental model:
#   - Each `stalls:` entry is a GROUP that volunteers /register as
#     (e.g. "Cocktailbar 1", "Biertheke Süd"). Multiple crews can pass
#     through the same group over the event without any config change —
#     they all /register at the same group name.
#   - `stalls[].location` is the physical area the group works at
#     ("Forum Süd", "DJ", "Mitte").
#   - `stalls[].type` is what the stand does ("Bier", "Cocktail",
#     "Tickets") — what BiMi needs to know to bring the right supplies.
#   - Ticket text shown to orga is "{location} [{type}]", e.g.
#     "Forum Süd [Cocktail] hat noch ~20 Becher". The group's *name* does
#     not appear in ticket text — handlers orient on location + type, not
#     on which crew is currently on shift.
#   - `orga_groups:` are the handler teams (Finanz, BiMi, ...). Each
#     ticket category routes to one orga group; one orga group is the
#     `default:` for any category not explicitly listed.
#   - `locations:` maps a location name to its Engelsystem location id.
#     Optional — only needed for /helpers to return shift lists.

stalls:
  # Visible groups — offered as options in /register's inline picker.
  - name: "Cocktailbar 1"
    location: "Forum Süd"
    type: "Cocktail"
  - name: "Cocktailbar 2"
    location: "Forum Süd"
    type: "Cocktail"
  - name: "Biertheke Süd"
    location: "Forum Süd"
    type: "Bier"
  - name: "Biertheke DJ"
    location: "DJ"
    type: "Bier"
  - name: "Biertheke Mitte"
    location: "Mitte"
    type: "Bier"

  # Hidden groups — accepted as registration targets via the textual
  # `/register <name>` argument only; NOT shown in the inline picker.
  # Use for internal / staff-only groups.
  - name: "Tickets"
    location: "Eingang"
    type: "Tickets"
    hidden: true

orga_groups:
  # The orga teams that handle tickets. Names here must not collide with
  # any stall name. Exactly one orga group must have `default: true` —
  # it catches categories not listed below.
  - name: "Finanz"
    categories: ["Geld"]
  - name: "BiMi"
    categories: ["Bier", "Cocktail", "Becher"]
  - name: "Helfen"
    categories: ["Helfer"]
  - name: "Zentrale"
    categories: ["Sonstiges"]
    default: true

# Optional. Maps each `stalls[].location` to its Engelsystem location id.
# Only required for /helpers (shift lookup) to work; groups whose
# location isn't listed here just won't return shifts.
locations:
  "Forum Süd": 12
  "DJ": 15
  "Mitte": 9
  "Eingang": 3
