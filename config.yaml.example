# UnifestBestellBot configuration for one event.
#
# Edit between events, then `systemctl restart unifestbestellbot`. The schema
# is validated at startup: a typo here will refuse to boot the bot.
#
# Mental model:
#   - Each `stalls:` entry is a STAND, identified by (location, type). There
#     is NO team identity in the bot. Whichever crew is on shift /registers
#     at the stand; multiple crews can cycle through the same stand over the
#     event without any config change.
#   - `stalls[].location` is the physical area (e.g. "Forum Süd", "DJ").
#     `stalls[].type` is what the stand does (e.g. "Bier", "Cocktail",
#     "Tickets"). Both appear in every ticket as "Forum Süd [Cocktail]" so
#     orga handlers can find the stand without knowing who's on shift.
#   - `orga_groups:` are the handler teams (Finanz, BiMi, ...). Each
#     ticket category routes to exactly one orga group; one orga group is
#     the `default:` for any category not explicitly listed.
#   - `locations:` maps a location name to its Engelsystem location id.
#     Optional — only needed for /helpers to return shift lists.
#
# Year-to-year changes:
#   - Stands moved / renamed / closed?  Edit `stalls:`.
#   - Stand changed type (e.g. Bier → Cocktail)?  Edit its `type:`.
#   - Different crew on shift?  No config change — they just /register
#     at the same stand identifier.
#   - New ticket category?  Add it to one orga group's `categories:`,
#     then add a row to FOLLOWUPS in src/unifestbestellbot/bot/request.py.

stalls:
  # Visible stands — offered as options in /register. Identifier shown to
  # users is "{location} {type}", e.g. "Forum Süd Cocktail".
  - location: "Forum Süd"
    type: "Cocktail"
  - location: "Forum Süd"
    type: "Bier"
  - location: "DJ"
    type: "Bier"
  - location: "Mitte"
    type: "Cocktail"
  - location: "Mitte"
    type: "Bier"

  # Hidden stands — accepted as a registration target but NOT shown in the
  # /register inline picker. Use for internal / staff-only groups.
  - location: "Eingang"
    type: "Tickets"
    hidden: true

orga_groups:
  # The orga teams that handle tickets. Names here must not collide with
  # any stand identifier ("{location} {type}"). Exactly one orga group
  # must have `default: true` — it catches categories not listed below.
  - name: "Finanz"
    categories: ["Geld"]
  - name: "BiMi"
    categories: ["Bier", "Cocktail", "Becher"]
  - name: "Helfen"
    categories: ["Helfer"]
  - name: "Zentrale"
    categories: ["Sonstiges"]
    default: true

# Optional. Maps each `stalls[].location` to its Engelsystem location id.
# Only required for /helpers (shift lookup) to work; stalls whose location
# isn't listed here just won't return shifts.
locations:
  "Forum Süd": 12
  "DJ": 15
  "Mitte": 9
  "Eingang": 3
