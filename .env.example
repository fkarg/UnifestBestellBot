# Copy this file to `.env` and fill in real values. `.env` is gitignored.

# Telegram credentials and well-known chat ids.
# Leave UPDATES_CHANNEL_ID unset (or commented out) to log channel
# notifications instead of posting them — useful for a test bot that shares
# a channel with prod.
TELEGRAM_TOKEN=123456:replace-me
DEVELOPER_CHAT_ID=0
UPDATES_CHANNEL_ID=0

# Engelsystem (used by the /helpers shift-lookup command)
ENGELSYSTEM_API_KEY=replace-me
ENGELSYSTEM_BASE_URL=https://helfen.unifest-karlsruhe.de/api/v0-beta/

# Storage and runtime
DATABASE_URL=sqlite:///./bot.db
CONFIG_PATH=./config.yaml
WEB_BIND=0.0.0.0:8000
LOG_LEVEL=INFO

# Display/window timezone. Stored timestamps are naive UTC; this only
# controls how /history and the shift digest render them and how the
# digest's operational window is interpreted. Read explicitly, so it does
# not depend on the VM's ambient timezone.
TIMEZONE=Europe/Berlin

# Logs rotate daily into LOG_DIR/bot.log; LOG_RETENTION_DAYS old files are kept.
LOG_DIR=./logs
LOG_RETENTION_DAYS=14
