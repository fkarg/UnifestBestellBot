# Copy this file to `.env` and fill in real values. `.env` is gitignored.

# Telegram credentials and well-known chat ids
TELEGRAM_TOKEN=123456:replace-me
DEVELOPER_CHAT_ID=0
UPDATES_CHANNEL_ID=0

# Engelsystem (used by the /helpers shift-lookup command)
ENGELSYSTEM_API_KEY=replace-me
ENGELSYSTEM_BASE_URL=https://helfen.unifest-karlsruhe.de/api/v0-beta/

# Storage and runtime
DATABASE_URL=sqlite:///./bot.db
CONFIG_PATH=./config.yaml
WEB_BIND=0.0.0.0:8000
LOG_LEVEL=INFO
